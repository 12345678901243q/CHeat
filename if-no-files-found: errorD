name: Build Donut Client

on:
  workflow_dispatch:
  push:
    branches: [ "main" ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java 21
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "9.5.0"

      - name: Build mod
        run: |
          if [ -f build.gradle ]; then
            PROJECT_DIR="."
          elif [ -f DonutClient/build.gradle ]; then
            PROJECT_DIR="DonutClient"
          else
            echo "Could not find build.gradle"
            exit 1
          fi
          gradle -p "$PROJECT_DIR" build

      - name: Upload JAR
        uses: actions/upload-artifact@v4
        with:
          name: Donut-Client-JAR
          path: |
            build/libs/*.jar
            DonutClient/build/libs/*.jar
          if-no-files-found: error
